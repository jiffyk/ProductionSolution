<Window x:Class="ProductionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Производство" Height="400" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Задание 1 (Сырье)">
                <StackPanel Margin="10">
                    <TextBlock Text="Тип продукции (1-3):"/>
                    <TextBox x:Name="TxtProductType" Text="1"/>

                    <TextBlock Text="Тип материала (1-2):"/>
                    <TextBox x:Name="TxtMaterialType" Text="1"/>

                    <TextBlock Text="Количество:"/>
                    <TextBox x:Name="TxtCount" Text="10"/>

                    <TextBlock Text="Ширина:"/>
                    <TextBox x:Name="TxtWidth" Text="2,5"/>

                    <TextBlock Text="Длина:"/>
                    <TextBox x:Name="TxtLength" Text="3,0"/>

                    <Button Content="Рассчитать" Click="BtnCalculate_Click" Margin="0,10,0,0" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtResult" FontWeight="Bold" Foreground="Blue" Margin="0,10,0,0" FontSize="14"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Задание 2 (Заказ)">
                <StackPanel Margin="10">
                    <TextBlock Text="Фамилия:"/>
                    <TextBox x:Name="TxtLastName" Text="Иванов"/>

                    <TextBlock Text="Имя:"/>
                    <TextBox x:Name="TxtFirstName" Text="Иван"/>

                    <TextBlock Text="Отчество (можно пустым):"/>
                    <TextBox x:Name="TxtPatronymic" Text="Иванович"/>

                    <Button Content="Создать заказ" Click="BtnOrder_Click" Margin="0,10,0,0" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtOrderResult" FontWeight="Bold" Foreground="Green" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>